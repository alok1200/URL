# Maximum download file size in megabytes (default: 500)
MAX_FILESIZE_MB=500

# Maximum video/audio duration in minutes (default: 180 = 3 hours)
MAX_DURATION_MIN=180

# Maximum /api/info requests per IP per minute (default: 10)
RATE_LIMIT_PER_MIN=10

# Maximum concurrent downloads per IP (default: 3)
MAX_CONCURRENT_PER_IP=3

# Maximum concurrent downloads globally (default: 3)
MAX_CONCURRENT_JOBS=3

# Download timeout in seconds (default: 300 = 5 minutes)
DOWNLOAD_TIMEOUT_SEC=300

# Optional path to a Netscape-format cookies.txt file (user's own account)
COOKIES_FILE=

# Optional HTTP/SOCKS proxy URL for yt-dlp (e.g. http://user:pass@host:port)
PROXY_URL=

# Optional custom temp directory (defaults to OS temp dir)
TEMP_DIR=

# Logging level: silent | error | info | debug (default: error)
LOG_LEVEL=error

# Optional custom binary paths if yt-dlp or ffmpeg are not on PATH
YTDLP_PATH=yt-dlp
FFMPEG_PATH=ffmpeg
